@page "/"
@inject BuildFitDataService DataService
@inject IJSRuntime JS

<PageTitle>BuildFit — 호환되는 조립 PC 추천</PageTitle>

<section class="hero-shell overflow-hidden border-b border-white/10 bg-[radial-gradient(circle_at_top_right,_rgba(190,242,100,0.14),_transparent_38%)]">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 lg:grid-cols-[1.1fr_.9fr] lg:px-8 lg:py-24">
        <div class="hero-copy self-center">
            <p class="mb-5 inline-flex rounded-full border border-lime-300/30 bg-lime-300/10 px-3 py-1 text-sm font-semibold text-lime-300">JSON 계약 기반 · 호환성 우선</p>
            <h1 class="max-w-3xl text-4xl font-black leading-tight tracking-tight sm:text-6xl">작동하는 조합만,<br><span class="text-lime-300">당신의 성향에 맞게.</span></h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">CPU부터 케이스, 파워, 조립비까지 빠짐없이 계산합니다. 소켓·메모리·크기·전력·보조전원 규칙을 통과한 사전 검증 조합만 보여드립니다.</p>
        </div>
        <div class="hero-stats grid grid-cols-2 gap-3 self-end">
            <StatCard Value="@(_data?.Products.Products.Count ?? 0)" Label="가격 포함 부품" />
            <StatCard Value="@(_data?.Builds.Builds.Count ?? 0)" Label="검증 조합" />
            <StatCard Value="@(_data?.Sources.Sources.Count ?? 0)" Label="아이코다 출처" />
            <StatCard Value="5" Label="호환 핵심 영역" />
        </div>
    </div>
</section>

<div class="mx-auto grid max-w-7xl gap-8 px-5 py-10 lg:grid-cols-[360px_1fr] lg:px-8 lg:py-14">
    <aside class="control-panel h-fit rounded-3xl border border-white/10 bg-slate-900 p-6 lg:sticky lg:top-6">
        <div class="mb-7"><p class="text-sm font-semibold text-lime-300">01 · 사용 조건</p><h2 class="mt-1 text-2xl font-bold">어떤 PC가 필요한가요?</h2></div>
        <div class="space-y-6">
            <fieldset>
                <legend class="mb-2 text-sm font-semibold text-slate-300">주 용도</legend>
                <div class="grid grid-cols-2 gap-2"><ChoiceButton Text="게임" Active="@(_purpose == BuildPurpose.Gaming)" Click="@(() => SetPurpose(BuildPurpose.Gaming))" /><ChoiceButton Text="영상·작업" Active="@(_purpose == BuildPurpose.Creator)" Click="@(() => SetPurpose(BuildPurpose.Creator))" /></div>
            </fieldset>
            <fieldset>
                <legend class="mb-2 text-sm font-semibold text-slate-300">목표 해상도</legend>
                <div class="grid grid-cols-2 gap-2"><ChoiceButton Text="FHD" Active="@(_resolution == "FHD")" Click="@(() => SetResolution("FHD"))" /><ChoiceButton Text="QHD" Active="@(_resolution == "QHD")" Click="@(() => SetResolution("QHD"))" /></div>
            </fieldset>
            <fieldset>
                <legend class="mb-2 text-sm font-semibold text-slate-300">목표 게임</legend>
                <select class="w-full rounded-xl border border-white/10 bg-slate-950/60 px-3 py-2.5 text-sm text-slate-100" @bind="_selectedGameId" @bind:after="ApplyGameTarget">
                    @foreach (var game in GameProfiles) { <option value="@game.Id">@game.Name · @game.Note</option> }
                </select>
                <div class="mt-2 grid grid-cols-4 gap-2">
                    @foreach (var fps in FpsTargets) { <ChoiceButton Text="@($"{fps} FPS")" Active="@(_targetFps == fps)" Click="@(() => SetTargetFps(fps))" /> }
                </div>
                <div class="mt-2 grid grid-cols-2 gap-2">
                    @foreach (var quality in QualityTargets) { <ChoiceButton Text="@quality.Name" Active="@(_qualityId == quality.Id)" Click="@(() => SetQuality(quality.Id))" /> }
                </div>
                <p class="mt-2 text-xs leading-5 text-slate-500">@SelectedGame.Description · @SelectedQuality.Name · 필요 성능 점수 @MinimumPerformanceScore점 이상</p>
            </fieldset>
            <fieldset>
                <legend class="mb-2 text-sm font-semibold text-slate-300">메모리</legend>
                <div class="grid grid-cols-2 gap-2"><ChoiceButton Text="32GB" Active="@(_memoryGb == 32)" Click="@(() => SetMemory(32))" /><ChoiceButton Text="64GB" Active="@(_memoryGb == 64)" Click="@(() => SetMemory(64))" /></div>
            </fieldset>
            <fieldset>
                <legend class="mb-2 text-sm font-semibold text-slate-300">추천 성향</legend>
                <div class="space-y-2">
                    <ModeButton Title="지금 성능" Description="32GB라면 16GB × 2 듀얼채널 우선" Mode="PreferenceMode.ImmediatePerformance" Current="_mode" Changed="SetMode" />
                    <ModeButton Title="균형" Description="성능·소음·확장성을 고르게 반영" Mode="PreferenceMode.Balanced" Current="_mode" Changed="SetMode" />
                    <ModeButton Title="확장 우선" Description="32GB라면 32GB × 1로 슬롯 보존" Mode="PreferenceMode.ExpansionFirst" Current="_mode" Changed="SetMode" />
                </div>
            </fieldset>
            <label class="block">
                <span class="mb-2 flex justify-between text-sm font-semibold text-slate-300"><span>예산</span><span class="text-lime-300">@Won(_budgetKrw)</span></span>
                <input class="w-full accent-lime-300" type="range" min="1200000" max="4000000" step="100000" @bind="_budgetKrw" @bind:event="oninput" @bind:after="Refresh" />
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 p-3 text-sm text-slate-300"><input class="h-4 w-4 accent-lime-300" type="checkbox" @bind="_preferQuiet" @bind:after="Refresh" />정숙성도 중요해요</label>
        </div>
    </aside>

    <section aria-live="polite">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
            <div><p class="text-sm font-semibold text-lime-300">02 · 검증 결과</p><h2 class="mt-1 text-3xl font-bold">완성 견적</h2><p class="mt-2 text-sm text-slate-400">@SelectedGame.Name · @_resolution · @SelectedQuality.Name · @_targetFps FPS 목표</p></div>
            @if (_data is not null) { <span class="rounded-full bg-emerald-400/10 px-3 py-1.5 text-sm font-semibold text-emerald-300">● JSON 계약 로드 완료</span> }
        </div>

        @if (_loading)
        {
            <div class="rounded-3xl border border-white/10 bg-slate-900 p-10 text-center text-slate-400">정형 데이터와 호환 규칙을 검증하고 있습니다…</div>
        }
        else if (_error is not null)
        {
            <div class="rounded-3xl border border-red-400/30 bg-red-400/10 p-6 text-red-200"><h3 class="font-bold">데이터 계약을 통과하지 못했습니다.</h3><p class="mt-2 break-words text-sm">@_error</p><p class="mt-3 text-sm">BuildFit은 확인되지 않은 기본값으로 추천을 계속하지 않습니다.</p></div>
        }
        else if (_recommendations.Count == 0)
        {
            <div class="rounded-3xl border border-amber-300/30 bg-amber-300/10 p-8 text-amber-100"><h3 class="text-xl font-bold">현재 검증된 조합에는 조건에 맞는 견적이 없습니다.</h3><p class="mt-2 text-sm text-amber-100/80">해상도·메모리·용도를 바꾸어 보세요. 미검증 부품을 임의 조합하지 않습니다.</p></div>
        }
        else
        {
            @foreach (var recommendation in _recommendations)
            {
                var componentLookup = recommendation.Products.ToDictionary(product => product.Id);
                <article class="build-card mb-6 overflow-hidden rounded-3xl border border-white/10 bg-slate-900 shadow-2xl shadow-black/20">
                    <div class="border-b border-white/10 bg-gradient-to-r from-lime-300/10 to-transparent p-6 sm:p-8">
                        <div class="flex flex-wrap items-start justify-between gap-4">
                            <div>
                                <div class="mb-3 flex flex-wrap gap-2"><span class="rounded-full bg-lime-300 px-3 py-1 text-xs font-black text-slate-950">호환 검증 완료</span><span class="rounded-full border border-white/15 px-3 py-1 text-xs text-slate-300">매칭 점수 @recommendation.MatchScore</span></div>
                                <h3 class="text-2xl font-black sm:text-3xl">@recommendation.Definition.Name</h3><p class="mt-2 max-w-2xl text-slate-300">@recommendation.Definition.Summary</p>
                            </div>
                            <div class="text-left sm:text-right"><p class="text-sm text-slate-400">배송비 포함 총 비용</p><strong class="text-3xl font-black text-lime-300">@Won(recommendation.Compatibility.TotalPriceKrw)</strong></div>
                        </div>
                    </div>
                    <div class="grid gap-8 p-6 sm:p-8 xl:grid-cols-[1fr_270px]">
                        <div class="space-y-3 sm:hidden">
                            @foreach (var component in recommendation.Definition.Components)
                            {
                                var product = componentLookup[component.ProductId];
                                <div class="rounded-xl border border-white/10 bg-slate-950/40 p-3">
                                    <div class="flex items-center justify-between gap-3 text-xs text-slate-500"><span>@CategoryName(product.Category)</span><span>수량 @component.Quantity</span></div>
                                    <p class="mt-1 break-words text-sm font-semibold leading-6 text-slate-200">@product.Name</p>
                                    <p class="mt-1 text-right text-sm tabular-nums text-slate-300">@Won((product.Price.AmountKrw + product.Price.ShippingKrw) * component.Quantity)</p>
                                </div>
                            }
                        </div>
                        <div class="hidden overflow-x-auto sm:block">
                            <table class="w-full min-w-[580px] text-left text-sm">
                                <thead class="border-b border-white/10 text-xs uppercase tracking-wider text-slate-500"><tr><th class="pb-3">분류</th><th class="pb-3">부품</th><th class="pb-3 text-center">수량</th><th class="pb-3 text-right">금액</th></tr></thead>
                                <tbody class="divide-y divide-white/5">
                                    @foreach (var component in recommendation.Definition.Components)
                                    {
                                        var product = componentLookup[component.ProductId];
                                        <tr><td class="py-3 pr-3 text-slate-500">@CategoryName(product.Category)</td><td class="py-3 pr-3 font-medium text-slate-200">@product.Name</td><td class="py-3 text-center text-slate-400">@component.Quantity</td><td class="py-3 text-right tabular-nums text-slate-300">@Won((product.Price.AmountKrw + product.Price.ShippingKrw) * component.Quantity)</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="space-y-4">
                            <div class="rounded-2xl border border-white/10 bg-slate-950/60 p-4"><p class="text-xs font-bold uppercase tracking-wider text-slate-500">파워 판정</p><p class="mt-2 text-lg font-bold">@recommendation.Compatibility.RequiredPowerSupplyWatts W 이상 필요</p><p class="mt-1 text-sm leading-6 text-slate-400">CPU·그래픽카드 피크 전력, 시스템 여유분과 안전 마진, 보조전원 단자를 함께 검사했습니다.</p></div>
                            <div class="rounded-2xl border border-white/10 bg-slate-950/60 p-4"><p class="text-xs font-bold uppercase tracking-wider text-slate-500">추천 근거</p><ul class="mt-2 space-y-2 text-sm text-slate-300">@foreach (var reason in recommendation.Definition.Reasons) { <li class="flex gap-2"><span class="text-lime-300">✓</span><span>@reason</span></li> }</ul></div>
                        </div>
                    </div>
                </article>
            }
        }
        <div class="mt-8 rounded-2xl border border-white/10 bg-slate-900/60 p-5 text-sm leading-6 text-slate-400"><strong class="text-slate-200">정형 데이터 원칙</strong> · 화면에 견적을 하드코딩하지 않습니다. <code>products.json</code>, <code>builds.json</code>, 호환 규칙과 추천 프로필을 읽고, 필수 제원이 없거나 규칙을 위반하면 결과에서 제외합니다.</div>
    </section>
</div>

@code {
    private BuildFitData? _data;
    private IReadOnlyList<RecommendedBuild> _recommendations = [];
    private bool _loading = true;
    private string? _error;
    private BuildPurpose _purpose = BuildPurpose.Gaming;
    private PreferenceMode _mode = PreferenceMode.ImmediatePerformance;
    private int _budgetKrw = 2_500_000;
    private int _memoryGb = 32;
    private string _resolution = "FHD";
    private bool _preferQuiet;
    private string _selectedGameId = "general";
    private int _targetFps = 120;
    private string _qualityId = "balanced";

    private static readonly int[] FpsTargets = [60, 120, 144, 240];
    private static readonly QualityTarget[] QualityTargets =
    [
        new("optimized", "최적화", -10), new("balanced", "균형", 0), new("high", "높음", 8), new("ultra", "울트라", 15)
    ];
    private static readonly GameProfile[] GameProfiles =
    [
        new("general", "직접 설정", "모든 게임", 0, "FHD", 120, "balanced", "원하는 해상도·FPS·품질을 직접 정합니다."),
        new("league", "리그 오브 레전드", "e스포츠 · FHD 240", -25, "FHD", 240, "high", "높은 프레임률 중심의 가벼운 e스포츠 게임입니다."),
        new("valorant", "발로란트", "e스포츠 · FHD 240", -24, "FHD", 240, "high", "반응성을 중시하는 고프레임 e스포츠 게임입니다."),
        new("overwatch2", "오버워치 2", "e스포츠 · FHD 144", -16, "FHD", 144, "high", "고주사율과 안정적인 프레임 유지가 중요한 게임입니다."),
        new("fc", "FC 온라인", "스포츠 · FHD 144", -26, "FHD", 144, "high", "상대적으로 낮은 GPU 요구량의 스포츠 게임입니다."),
        new("minecraft", "마인크래프트", "샌드박스 · FHD 120", -15, "FHD", 120, "high", "일반 플레이 기준이며, 고사양 쉐이더는 별도 고려가 필요합니다."),
        new("genshin", "원신", "오픈월드 · FHD 120", -12, "FHD", 120, "high", "일반적인 오픈월드 액션 게임 기준입니다."),
        new("lostark", "로스트아크", "MMORPG · QHD 60", -8, "QHD", 60, "high", "대규모 전투와 멀티태스킹을 고려한 기준입니다."),
        new("fortnite", "포트나이트", "배틀로얄 · FHD 144", -6, "FHD", 144, "high", "성능 모드와 고품질 모드의 차이가 큰 게임입니다."),
        new("apex", "에이펙스 레전드", "배틀로얄 · FHD 144", -3, "FHD", 144, "high", "고프레임 경쟁 플레이를 고려한 기준입니다."),
        new("pubg", "배틀그라운드", "배틀로얄 · QHD 60", 2, "QHD", 60, "high", "시야거리와 대규모 교전에서의 프레임 여유를 반영합니다."),
        new("eldenring", "엘든 링", "AAA 액션 · QHD 60", 3, "QHD", 60, "high", "고품질 싱글플레이 액션 게임 기준입니다."),
        new("cyberpunk", "사이버펑크 2077", "AAA RPG · QHD 60", 11, "QHD", 60, "high", "레이 트레이싱 등 높은 그래픽 품질을 고려한 기준입니다."),
        new("blackmyth", "검은 신화: 오공", "AAA 액션 · QHD 60", 13, "QHD", 60, "high", "상대적으로 높은 GPU 성능을 요구하는 기준입니다."),
        new("monsterhunter", "몬스터 헌터 와일즈", "AAA 액션 · QHD 60", 14, "QHD", 60, "high", "그래픽 옵션과 고해상도 목표에 높은 여유가 필요한 기준입니다.")
    ];

    private GameProfile SelectedGame => GameProfiles.Single(game => game.Id == _selectedGameId);
    private QualityTarget SelectedQuality => QualityTargets.Single(quality => quality.Id == _qualityId);
    private int MinimumPerformanceScore => Math.Clamp((_targetFps switch { 60 => 58, 120 => 72, 144 => 80, 240 => 92, _ => 80 }) + SelectedGame.DemandAdjustment + SelectedQuality.ScoreAdjustment, 0, 100);

    protected override async Task OnInitializedAsync()
    {
        try { _data = await DataService.LoadAsync(); Refresh(); }
        catch (Exception exception) when (exception is HttpRequestException or InvalidDataException or System.Text.Json.JsonException) { _error = exception.Message; }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("BuildFitMotion.init");
        else await JS.InvokeVoidAsync("BuildFitMotion.refresh");
    }

    private void Refresh()
    {
        if (_data is null) return;
        _recommendations = RecommendationEngine.Recommend(_data, new(_purpose, _mode, _budgetKrw, _memoryGb, _resolution, _preferQuiet, MinimumPerformanceScore));
    }

    private void SetPurpose(BuildPurpose value) { _purpose = value; Refresh(); }
    private void SetResolution(string value) { _resolution = value; Refresh(); }
    private void SetMemory(int value) { _memoryGb = value; Refresh(); }
    private void SetMode(PreferenceMode value) { _mode = value; Refresh(); }
    private void SetTargetFps(int value) { _targetFps = value; Refresh(); }
    private void SetQuality(string value) { _qualityId = value; Refresh(); }
    private void ApplyGameTarget()
    {
        _resolution = SelectedGame.DefaultResolution;
        _targetFps = SelectedGame.DefaultFps;
        _qualityId = SelectedGame.DefaultQualityId;
        Refresh();
    }
    private static string Won(int value) => $"{value:N0}원";
    private sealed record GameProfile(string Id, string Name, string Note, int DemandAdjustment, string DefaultResolution, int DefaultFps, string DefaultQualityId, string Description);
    private sealed record QualityTarget(string Id, string Name, int ScoreAdjustment);
    private static string CategoryName(ProductCategory category) => category switch
    {
        ProductCategory.Cpu => "CPU", ProductCategory.CpuCooler => "CPU 쿨러", ProductCategory.Motherboard => "메인보드", ProductCategory.Memory => "메모리", ProductCategory.GraphicsCard => "그래픽카드", ProductCategory.Storage => "SSD", ProductCategory.Case => "케이스", ProductCategory.PowerSupply => "파워", ProductCategory.Assembly => "조립", _ => category.ToString()
    };
}
