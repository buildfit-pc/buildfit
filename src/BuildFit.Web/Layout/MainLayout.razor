@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-950 text-slate-100">
    <header class="app-header border-b border-white/10 bg-slate-950/90 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">
            <a class="flex items-center gap-3" href="">
                <span class="brand-mark grid h-10 w-10 place-items-center rounded-xl bg-lime-300 font-black text-slate-950">BF</span>
                <span><strong class="block text-lg leading-none">BuildFit</strong><small class="text-xs text-slate-400">부품도 맞게, 나에게도 맞게.</small></span>
            </a>
            <a class="rounded-full border border-white/15 px-4 py-2 text-sm text-slate-300 transition hover:border-lime-300 hover:text-lime-300" href="https://github.com/buildfit-pc/buildfit" target="_blank" rel="noreferrer">공개 데이터 보기</a>
        </div>
    </header>
    <main>@Body</main>
    <footer class="border-t border-white/10 px-5 py-8 text-center text-sm text-slate-500">가격은 수집 시점의 아이코다 판매가이며 변동될 수 있습니다. 실제 주문 전 판매 페이지에서 재확인하세요.</footer>
</div>
