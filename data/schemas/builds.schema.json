{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildfit-pc.github.io/schemas/builds.schema.json",
  "title": "BuildFit verified builds",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "builds"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "builds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "summary", "purposes", "preference", "targetMemoryGb", "targetResolution", "performanceScore", "quietScore", "expansionScore", "components", "reasons"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "purposes": { "type": "array", "minItems": 1, "items": { "enum": ["Office", "Gaming", "Creator"] } },
          "preference": { "enum": ["ImmediatePerformance", "Balanced", "ExpansionFirst"] },
          "targetMemoryGb": { "type": "integer", "minimum": 8 },
          "targetResolution": { "enum": ["FHD", "QHD", "4K"] },
          "performanceScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "quietScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "expansionScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "components": {
            "type": "array",
            "minItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["productId", "quantity"],
              "properties": {
                "productId": { "type": "string", "minLength": 1 },
                "quantity": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
