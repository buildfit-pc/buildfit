{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildfit-pc.github.io/schemas/products.schema.json",
  "title": "BuildFit product catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capturedAt", "products"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "manufacturer", "price", "sourceId", "sourceProductId", "spec"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "enum": ["Cpu", "CpuCooler", "Motherboard", "Memory", "GraphicsCard", "Storage", "Case", "PowerSupply", "Assembly"] },
          "manufacturer": { "type": "string", "minLength": 1 },
          "sourceId": { "type": "string", "minLength": 1 },
          "sourceProductId": { "type": "string", "pattern": "^[0-9]+$" },
          "price": {
            "type": "object",
            "additionalProperties": false,
            "required": ["amountKrw", "shippingKrw", "capturedAt", "available"],
            "properties": {
              "amountKrw": { "type": "integer", "minimum": 1 },
              "shippingKrw": { "type": "integer", "minimum": 0 },
              "capturedAt": { "type": "string", "format": "date-time" },
              "available": { "type": "boolean" }
            }
          },
          "spec": { "type": "object" }
        }
      }
    }
  }
}
