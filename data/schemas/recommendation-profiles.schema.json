{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "performanceWeight", "quietWeight", "expansionWeight", "memoryLayoutRule", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["ImmediatePerformance", "Balanced", "ExpansionFirst"] },
          "performanceWeight": { "type": "integer", "minimum": 0 },
          "quietWeight": { "type": "integer", "minimum": 0 },
          "expansionWeight": { "type": "integer", "minimum": 0 },
          "memoryLayoutRule": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
